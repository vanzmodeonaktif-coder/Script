local renderConn = RunService.RenderStepped:Connect(function()
    if not State.visualRadius then
        if ringSG then ringSG.Enabled = false end
        return
    end
    ensureRing()
    if not ringPart then return end
    local myChar = LP.Character
    if not myChar then ringSG.Enabled = false return end
    local hrp = myChar:FindFirstChild("HumanoidRootPart")
    if not hrp then ringSG.Enabled = false return end
    ringSG.Enabled = true

    local pos = hrp.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {myChar, ringPart}
    local hit = workspace:Raycast(pos, Vector3.new(0, -50, 0), rp)
    local groundY = (hit and hit.Position.Y or (pos.Y - 3)) - 0.1
    local vr = math.min(State.radius, MAX_VISUAL_RADIUS)
    if vr < 0.5 then vr = 0.5 end
    ringPart.Size   = Vector3.new(vr * 2, 0.05, vr * 2)
    ringPart.CFrame = CFrame.new(pos.X, groundY, pos.Z)
end)

