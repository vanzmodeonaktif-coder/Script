-- ============ PARRY BUTTON ============
local cachedBtn = nil
local function getParryButton()
    if cachedBtn and cachedBtn.Parent then return cachedBtn end
    cachedBtn = nil
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then Debug.btnPath = "no PlayerGui" return nil end
    for _, folderName in ipairs({"Survivor-mob", "Survivor-con", "Survivor"}) do
        local folder = pg:FindFirstChild(folderName)
        if folder then
            local ctrl = folder:FindFirstChild("Controls")
            if ctrl then
                local b = ctrl:FindFirstChild("Gui-mob")
                if b then
                    cachedBtn = b
                    Debug.btnPath = folderName .. "/Controls/Gui-mob"
                    return b
                end
            end
        end
    end
    Debug.btnPath = "not found"
    return nil
end

local lastTriggerAt = 0
local function triggerParry(reason)
    Debug.triggerAttempts = Debug.triggerAttempts + 1
    Debug.lastTriggerAt = tick()
    Debug.lastTriggerReason = tostring(reason or "-")

    if tick() - lastTriggerAt < 0.08 then
        Debug.lastError = "debounce"
        return false
    end
    lastTriggerAt = tick()

    local btn = getParryButton()
    if not btn then
        Debug.lastError = "no button"
        return false
    end

    local ap = btn.AbsolutePosition
    local as = btn.AbsoluteSize
    local cx = ap.X + as.X * 0.5
    local cy = ap.Y + as.Y * 0.5
    local pos = Vector3.new(cx, cy, 0)

    local fired = false
    if firesignal then
        local ok = pcall(firesignal, btn.MouseButton1Down, pos, pos)
        if ok then
            fired = true
            Debug.lastFireMethod = "firesignal"
        end
    end
    if not fired and getconnections then
        local ok, conns = pcall(getconnections, btn.MouseButton1Down)
        if ok and conns then
            Debug.btnConns = #conns
            for _, c in ipairs(conns) do
                if c and c.Fire then
                    pcall(c.Fire, pos, pos)
                    fired = true
                end
            end
            if fired then Debug.lastFireMethod = "getconnections" end
        end
    end

    if not fired then
        Debug.lastError = "trigger failed"
        return false
    end

    task.delay(0.02, function()
        if firesignal then
            pcall(firesignal, btn.MouseButton1Up, pos, pos)
        end
    end)

    Debug.lastError = "-"
    return true
end

-- ============ KILLER HOOK ============
local currentKiller  = nil
local killerHookConn = nil
local hookedAnimator = nil

local function unhookKiller()
    if killerHookConn then pcall(function() killerHookConn:Disconnect() end) end
    killerHookConn = nil
    currentKiller  = nil
    hookedAnimator = nil
    Debug.hooked = false
    Debug.animatorPath = "-"
end

local function handleAnim(track)
    if not State.autoParry then
        Debug.lastError = "autoParry off"
        return
    end
    local anim = track.Animation
    if not anim then return end
    local id = string.match(anim.AnimationId or "", "%d+")
    if not id then return end
    Debug.lastAnimId = id
    Debug.lastAnimAgo = tick()
    if not LUNGE_IDS[id] then return end

    local killerChar = currentKiller
    if not killerChar or not killerChar.Parent then
        Debug.lastError = "no killer char"
        return
    end
    if not killerChar:FindFirstChild("Lookscriptkiller", true) then
        Debug.lastError = "no Lookscriptkiller"
        return
    end
    local myChar = LP.Character
    if not myChar then Debug.lastError = "no myChar" return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local kHRP  = killerChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not kHRP then Debug.lastError = "no HRP" return end
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then Debug.lastError = "dead" return end

    local delta = myHRP.Position - kHRP.Position
    local dist  = delta.Magnitude
    Debug.distance = dist
    if dist > State.radius then Debug.lastError = "out radius" return end

    if dist > 0.01 then
        local toMe = delta.Unit
        local fdot = kHRP.CFrame.LookVector:Dot(toMe)
        Debug.facing = fdot
        if fdot < State.dot then Debug.lastError = "not facing" return end
    end

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {myChar, killerChar}
    rp.IgnoreWater = true
    local wallHit = workspace:Raycast(myHRP.Position, kHRP.Position - myHRP.Position, rp)
    Debug.wallHit = wallHit and (wallHit.Instance and wallHit.Instance:GetFullName() or "hit") or "clear"
    if wallHit then Debug.lastError = "wall" return end

    triggerParry("anim:"..id)
end

local function tryHook(killerChar)
    if not killerChar then return end
    local hum = killerChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = killerChar:FindFirstChildOfClass("Animator") end
    if not animator then animator = killerChar:FindFirstChild("Animator", true) end
    if not animator then return end
    if hookedAnimator == animator and killerHookConn then return end

    if killerHookConn then pcall(function() killerHookConn:Disconnect() end) end
    hookedAnimator = animator
    Debug.animatorPath = animator:GetFullName()
    killerHookConn = animator.AnimationPlayed:Connect(function(track)
        pcall(handleAnim, track)
    end)
    Debug.hooked = true
end

task.spawn(function()
    while true do
        task.wait(0.016)
        local kchar = nil
        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local c = p.Character
                if c and c:FindFirstChild("Lookscriptkiller", true) then
                    count = count + 1
                    if not kchar then kchar = c end
                end
            end
        end
        Debug.killerCount = count
        if kchar then
            if currentKiller ~= kchar then
                unhookKiller()
                currentKiller = kchar
            end
            if not killerHookConn then tryHook(kchar) end
        else
            if currentKiller then unhookKiller() end
        end
    end
end)

