    floatBtn.Position = floatHasMoved and floatPos or UDim2.fromScale(0.5, 0.5)
    main.Visible = false
    floatBtn.Visible = true
end

minBtn.MouseButton1Click:Connect(showFloat)

closeBtn.MouseButton1Click:Connect(function()
    unhookKiller()
    if renderConn then pcall(function() renderConn:Disconnect() end) end
    if ringPart then pcall(function() ringPart:Destroy() end) end
    gui:Destroy()
end)

lockBtn.MouseButton1Click:Connect(function()
    isLocked = not isLocked
    lockBtn.Text = isLocked and "🔒" or "🔓"
end)

local fDragging, fMoved, fStart, fStartPos = false, false, nil, nil
floatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        fDragging = true
        fMoved    = false
        fStart    = input.Position
        fStartPos = floatBtn.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if not fDragging or isLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - fStart
        if delta.Magnitude > 4 then fMoved = true end
        if fMoved then
            floatBtn.Position = UDim2.new(
                fStartPos.X.Scale, fStartPos.X.Offset + delta.X,
                fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y
            )
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if fDragging then
            if fMoved then
                floatPos = floatBtn.Position
                floatHasMoved = true
            else
                showMain()
            end
            fDragging = false
            fStart = nil
        end
    end
end)

local mDragging, mStart, mStartPos = false, nil, nil
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        mDragging = true
        mStart    = input.Position
        mStartPos = main.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if not mDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - mStart
        main.Position = UDim2.new(
            mStartPos.X.Scale, mStartPos.X.Offset + delta.X,
            mStartPos.Y.Scale, mStartPos.Y.Offset + delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        mDragging = false
    end
end)
