    ringSG.Face           = Enum.NormalId.Top
    ringSG.AlwaysOnTop    = true
    ringSG.LightInfluence = 0
    ringSG.SizingMode     = Enum.SurfaceGuiSizingMode.FixedSize
    ringSG.CanvasSize     = Vector2.new(1024, 1024)
