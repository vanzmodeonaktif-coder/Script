end

-- ==========================================
-- DRAG SYSTEM (DELTA-BASED, MORE RELIABLE)
-- ==========================================
local function startDragMain(inputPosition)
    if State.IsLocked then return end
    State.IsDragging = true
    State.DragStartInput = inputPosition
    State.DragStartPos = MainFrame.Position
end

local function startDragIcon(inputPosition)
    State.IsDragging = true
    State.DragStartInput = inputPosition
    State.DragStartPos = MinIcon.Position
end

local function updateDrag(currentInput)
    if not State.IsDragging or not State.DragStartInput then return end
    local delta = currentInput - State.DragStartInput
    local newPos = UDim2.new(
        State.DragStartPos.X.Scale, State.DragStartPos.X.Offset + delta.X,
        State.DragStartPos.Y.Scale, State.DragStartPos.Y.Offset + delta.Y
    )
    if State.IsMinimized then
        MinIcon.Position = newPos
    else
        MainFrame.Position = newPos
    end
end

local function endDrag()
    State.IsDragging = false
    State.DragStartInput = nil
    State.DragStartPos = nil
end

