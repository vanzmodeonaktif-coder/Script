-- ==========================================
-- UTILITY FUNCTIONS
-- ==========================================
local function findKiller()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if player.Character:FindFirstChild("Lookscriptkiller", true) then
                return player
            end
        end
    end
    return nil
end

local function getTargetPart(character)
    if not character then return nil end
    for _, partName in ipairs(CONFIG.TARGET_PRIORITY) do
        local part = character:FindFirstChild(partName)
        if part then return part end
    end
    return nil
end

local function detectSkin()
    local char = LocalPlayer.Character
    if not char then return nil end
    local twistOfFate = char:FindFirstChild("Twist of Fate")
    if not twistOfFate then return nil end
    local rightArm = twistOfFate:FindFirstChild("Right Arm")
    if not rightArm then return nil end
    for _, child in pairs(rightArm:GetChildren()) do
        if child:IsA("Model") and not child:IsA("Script") and not child:IsA("LocalScript") then
            return child
        end
    end
    return nil
end

local function getMuzzlePosition(character)
    if not character then return nil end
    if State.SkinModel then
        local smokePart = State.SkinModel:FindFirstChild("SmokePart", true)
        if smokePart and smokePart:IsA("BasePart") then return smokePart.Position end
        local barrel = State.SkinModel:FindFirstChild("barrel", true)
        if barrel and barrel:IsA("BasePart") then return barrel.Position end
        if State.SkinModel.PrimaryPart then return State.SkinModel.PrimaryPart.Position end
    end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then return (hrp.CFrame * CFrame.new(0.7, 1.373, -2.5)).Position end
    return nil
end

local function checkWall(origin, targetPos)
    local direction = targetPos - origin
    if direction.Magnitude < 0.1 then return false end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local excludeList = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then table.insert(excludeList, p.Character) end
    end
    if State.SkinModel then table.insert(excludeList, State.SkinModel) end
    raycastParams.FilterDescendantsInstances = excludeList
    local result = workspace:Raycast(origin, direction, raycastParams)
    return result ~= nil
end

local function isInFOV(targetPos)
    local cameraDir = Camera.CFrame.LookVector
    local cameraPos = Camera.CFrame.Position
    local toTarget = (targetPos - cameraPos)
    if toTarget.Magnitude < 0.1 then return true end
    local dot = math.clamp(cameraDir:Dot(toTarget.Unit), -1, 1)
    local angle = math.deg(math.acos(dot))
    return angle <= (State.FOV / 2)
end

-- ==========================================
-- PREDICT MOVE (LEADING SHOT)
-- ==========================================
local function predictPosition(killerChar, muzzlePos)
    local targetPart = getTargetPart(killerChar)
    if not targetPart then return nil end
    
    local hrp = killerChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return targetPart.Position end
    
    local killerVelocity = hrp.Velocity
    if killerVelocity.Magnitude < 1 then
        return targetPart.Position -- tidak bergerak signifikan
    end
    
    local currentPos = targetPart.Position
    local distance = (currentPos - muzzlePos).Magnitude
    local timeToHit = distance / CONFIG.BULLET_SPEED
    
    -- Iterative prediction untuk akurasi
    local predictedPos = currentPos
    for i = 1, CONFIG.PREDICT_ITERATIONS do
        local futurePos = currentPos + killerVelocity * timeToHit
        local futureDistance = (futurePos - muzzlePos).Magnitude
        timeToHit = futureDistance / CONFIG.BULLET_SPEED
        predictedPos = futurePos
    end
    
    return predictedPos
end

local function getEffectiveTargetPos(character, muzzlePos)
    local targetPart = getTargetPart(State.KillerChar)
    if not targetPart then return nil end
    
    if State.PredictMove then
        return predictPosition(State.KillerChar, muzzlePos)
    else
        return targetPart.Position
    end
end

-- ==========================================
-- APPLY HOOK
-- ==========================================
Effects.aimDirection = function(character, cameraCFrame)
    if not State.SilentAim then
        return originalAimDirection(character, cameraCFrame)
    end
    
    local muzzlePos = getMuzzlePosition(character)
    if not muzzlePos then
        return originalAimDirection(character, cameraCFrame)
    end
    
    local targetPos = getEffectiveTargetPos(character, muzzlePos)
    if not targetPos then
        return originalAimDirection(character, cameraCFrame)
    end
    
    if not isInFOV(targetPos) then
        return originalAimDirection(character, cameraCFrame)
    end
    
    local direction = (targetPos - muzzlePos)
    if direction.Magnitude < 0.01 then
        return originalAimDirection(character, cameraCFrame)
    end
    
    return direction.Unit
end

