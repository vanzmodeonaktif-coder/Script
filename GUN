-- ==========================================
-- MAIN RENDER LOOP
-- ==========================================
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    
    if State.SilentAim and not State.SkinModel then
        State.SkinModel = detectSkin()
    end
    
    local currentKiller = findKiller()
    if currentKiller ~= State.Killer then
        State.Killer = currentKiller
        State.KillerChar = currentKiller and currentKiller.Character
    end
    if State.Killer and State.Killer.Character ~= State.KillerChar then
        State.KillerChar = State.Killer.Character
    end
    
    if not State.SilentAim then
        FOVCircleStroke.Color = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Status: Disabled"
        StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
        return
    end
    
    if not State.KillerChar then
        FOVCircleStroke.Color = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Status: Scanning..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        return
    end
    
    local targetPart = getTargetPart(State.KillerChar)
    if not targetPart then
        FOVCircleStroke.Color = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Status: No body part"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local muzzlePos = getMuzzlePosition(LocalPlayer.Character)
    if not muzzlePos then
        FOVCircleStroke.Color = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Status: No muzzle"
        StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
        return
    end
    
    -- Pakai effective target pos (dengan atau tanpa predict)
    local effectiveTargetPos = getEffectiveTargetPos(LocalPlayer.Character, muzzlePos)
    if not effectiveTargetPos then
        FOVCircleStroke.Color = Color3.fromRGB(255, 255, 255)
        return
    end
    
    local inFOV = isInFOV(effectiveTargetPos)
    
    if not inFOV then
        FOVCircleStroke.Color = Color3.fromRGB(255, 255, 255)
        local cameraDir = Camera.CFrame.LookVector
        local toTarget = (effectiveTargetPos - Camera.CFrame.Position)
        local angle = 0
        if toTarget.Magnitude > 0.1 then
            angle = math.deg(math.acos(math.clamp(cameraDir:Dot(toTarget.Unit), -1, 1)))
        end
        StatusLabel.Text = string.format("Status: Out of FOV (%d°)", math.floor(angle))
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        return
    end
    
    -- In FOV: Check wall for color coding
    local isBlocked = checkWall(muzzlePos, effectiveTargetPos)
    FOVCircleStroke.Color = isBlocked and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 50)
    
    local dist = math.floor((effectiveTargetPos - Camera.CFrame.Position).Magnitude)
    local predictStatus = State.PredictMove and " | PREDICT" or ""
    
    if isBlocked then
        StatusLabel.Text = string.format("Status: LOCKED | %dm | BLOCKED%s", dist, predictStatus)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
