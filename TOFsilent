do
    local BLOCK = "7_ANTI_KNOCK"
    local function handler(err)
        warn(string.format("[VANZ ERROR][%s] %s\n%s",
            BLOCK, tostring(err), debug.traceback("", 2)))
    end

    xpcall(function()
        local Players    = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local LocalPlayer = Players.LocalPlayer

        local RS = game:GetService("ReplicatedStorage")
        local EnableCollision
        pcall(function() EnableCollision = RS.Remotes.Collision.EnableCollision end)

        if _G.vanz.Runtime.GuardConn then
            _G.vanz.Runtime.GuardConn:Disconnect()
        end

        local lastFire = 0
        local lastHealth = nil

        _G.vanz.Runtime.GuardConn = RunService.Heartbeat:Connect(function()
            if not _G.vanz.Settings.AntiKnock then return end
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end

            local now = tick()
            local isKnocked = false
            if lastHealth and (lastHealth - hum.Health) >= 15 then
                isKnocked = true
            end
            lastHealth = hum.Health

            local shouldFire = isKnocked or (now - lastFire >= 2)
            if shouldFire and EnableCollision then
                lastFire = now
                pcall(function() EnableCollision:FireServer() end)
            end
        end)
    end, handler)
end

