do
    local BLOCK = "10_VISUAL_LINE"
    local function handler(err)
        warn(string.format("[VANZ ERROR][%s] %s\n%s",
            BLOCK, tostring(err), debug.traceback("", 2)))
    end

    xpcall(function()
        local Players     = game:GetService("Players")
        local RunService  = game:GetService("RunService")
        local LocalPlayer = Players.LocalPlayer

        local hasDrawing = (type(Drawing) == "table" and type(Drawing.new) == "function")
        if not hasDrawing then warn("[VANZ] Drawing gak ada.") return end

        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Color3.fromRGB(255, 55, 55)
        line.Thickness = 2
        line.Transparency = 1
        line.From = Vector2.new(0, 0)
        line.To   = Vector2.new(0, 0)
        _G.vanz.Runtime.DrawLine = line

        local dot = Drawing.new("Circle")
        dot.Visible = false
        dot.Color = Color3.fromRGB(255, 55, 55)
        dot.Thickness = 2
        dot.Radius = 6
        dot.Filled = false
        dot.Transparency = 1
        _G.vanz.Runtime.DrawDot = dot

        local rawDot = Drawing.new("Circle")
        rawDot.Visible = false
        rawDot.Color = Color3.fromRGB(255, 200, 0)
        rawDot.Thickness = 1
        rawDot.Radius = 4
        rawDot.Filled = false
        rawDot.Transparency = 0.6
        _G.vanz.Runtime.DrawRawDot = rawDot

        local function Project(worldPos, cam)
            local vp = cam.ViewportSize
            local cx, cy = vp.X * 0.5, vp.Y * 0.5
            local sp = cam:WorldToViewportPoint(worldPos)
            if sp.Z > 0 then return Vector2.new(sp.X, sp.Y) end
            local dx, dy = cx - sp.X, cy - sp.Y
            local len = math.sqrt(dx*dx + dy*dy)
            if len < 1 then return Vector2.new(cx, cy + 2000) end
            local scale = 3000 / len
            return Vector2.new(cx + dx*scale, cy + dy*scale)
        end

        local function GetGunPos()
            local char = LocalPlayer.Character
            if not char then return nil end
            local tof = char:FindFirstChild("Twist of Fate")
            if tof then
                local rightArm = tof:FindFirstChild("Right Arm")
                if rightArm then
                    local muzzle = rightArm:FindFirstChild("gun")
                        or rightArm:FindFirstChildWhichIsA("BasePart", true)
                    if muzzle and muzzle:IsA("BasePart") then
                        return muzzle.Position
                    end
                end
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            return hrp and (hrp.Position + Vector3.new(0,1,0)) or nil
        end

local function GetTargetData()
    local tgt = _G.vanz.Runtime.Target
    if not tgt then return nil, nil end
    local char = tgt.Character
    if not char then return nil, nil end
    local part = char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("Head")
    if not (part and part:IsA("BasePart") and part.Parent) then return nil, nil end

    -- === LATERAL OFFSET (sinkron dengan FireTof) ===
    local rawPos = part.Position
    local off  = _G.vanz.AimCfg.lateralOffset or 0
    local axis = _G.vanz.AimCfg.lateralAxis or "RightVector"
    if off ~= 0 then
        local ok, axisVec = pcall(function() return part.CFrame[axis] end)
        if ok and axisVec then
            rawPos = rawPos + axisVec * off
        end
    end

    local origin = GetGunPos()
    if not origin then return rawPos, rawPos end

    local cfg = _G.vanz.AimCfg
    local speed = cfg.bulletSpeed
    if typeof(speed) ~= "number" or speed <= 0 then speed = 200 end

    local vel = _G.vanz.GetPlayerVelocity and _G.vanz.GetPlayerVelocity(tgt) or Vector3.zero

    if not cfg.leadPrediction then
        return rawPos, rawPos
    end

    local iter = cfg.leadIterations or 9999
    local predicted = rawPos
    for i = 1, iter do
        local dist = (predicted - origin).Magnitude
        local t = dist / speed
        predicted = rawPos + vel * t
    end

    return rawPos, predicted
end

        if _G.vanz.Runtime.LineConn then
            _G.vanz.Runtime.LineConn:Disconnect()
        end

        _G.vanz.Runtime.LineConn = RunService.RenderStepped:Connect(function()
            if not _G.vanz.Settings.VisualLine then
                line.Visible = false; dot.Visible = false; rawDot.Visible = false
                return
            end

            local gunPos = GetGunPos()
            local rawPos, predPos = GetTargetData()
            local cam = workspace.CurrentCamera

            if not (gunPos and predPos and cam) then
                line.Visible = false; dot.Visible = false; rawDot.Visible = false
                return
            end

            line.From = Project(gunPos, cam)
            line.To   = Project(predPos, cam)
            line.Visible = true

            dot.Position = Project(predPos, cam)
            dot.Visible = true

            if rawPos then
                rawDot.Position = Project(rawPos, cam)
                rawDot.Visible = _G.vanz.AimCfg.leadPrediction
            end
        end)

        _G.vanz.Events.VisualLine = function(enabled)
            if not enabled then
                if _G.vanz.Runtime.DrawLine then _G.vanz.Runtime.DrawLine.Visible = false end
                if _G.vanz.Runtime.DrawDot then _G.vanz.Runtime.DrawDot.Visible = false end
                if _G.vanz.Runtime.DrawRawDot then _G.vanz.Runtime.DrawRawDot.Visible = false end
            end
        end
    end, handler)
end

