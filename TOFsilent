-- 2_FPS_MONITOR
--========================================================--
do
    local BLOCK = "2_FPS_MONITOR"
    local function handler(err)
        warn(string.format("[VANZ ERROR][%s] %s\n%s",
            BLOCK, tostring(err), debug.traceback("", 2)))
    end

    xpcall(function()
        local RunService = game:GetService("RunService")

        _G.vanz.Runtime.SmoothFPS = 60
        _G.vanz.Runtime.FrameTimeAcc = 0
        _G.vanz.Runtime.FrameCount = 0
        _G.vanz.Runtime.LastFPSSample = tick()

        RunService.Heartbeat:Connect(function(dt)
            local now = tick()
            _G.vanz.Runtime.FrameTimeAcc = _G.vanz.Runtime.FrameTimeAcc + dt
            _G.vanz.Runtime.FrameCount = _G.vanz.Runtime.FrameCount + 1

            if now - _G.vanz.Runtime.LastFPSSample >= 0.5 then
                local avgDt = _G.vanz.Runtime.FrameTimeAcc / math.max(_G.vanz.Runtime.FrameCount, 1)
                local fps = 1 / math.max(avgDt, 0.001)
                _G.vanz.Runtime.SmoothFPS = _G.vanz.Runtime.SmoothFPS * 0.7 + fps * 0.3
                _G.vanz.Runtime.FrameTimeAcc = 0
                _G.vanz.Runtime.FrameCount = 0
                _G.vanz.Runtime.LastFPSSample = now
            end
        end)

        print("[VANZ] FPS monitor ready.")
    end, handler)
end

--========================================================--
-- 3_TARGET_SCAN
--========================================================--
do
    local BLOCK = "3_TARGET_SCAN"
    local function handler(err)
        warn(string.format("[VANZ ERROR][%s] %s\n%s",
            BLOCK, tostring(err), debug.traceback("", 2)))
    end

    xpcall(function()
        local Players     = game:GetService("Players")
        local RunService  = game:GetService("RunService")
        local LocalPlayer = Players.LocalPlayer

        local function Classify(plr)
            if not plr or plr == LocalPlayer then return "self" end
            local team = plr.Team
            if not team then return "unknown" end

            local cfg  = _G.vanz.TeamCfg
            local name = string.lower(team.Name or "")
            for _, kw in ipairs(cfg.enemyKeywords) do
                if string.find(name, kw, 1, true) then return "enemy" end
            end
            for _, kw in ipairs(cfg.allyKeywords) do
                if string.find(name, kw, 1, true) then return "ally" end
            end
            local tc = team.TeamColor
            local c  = tc and tc.Color
            if c then
                if c.R >= cfg.enemyR and c.G < 0.45 and c.B < 0.45 then return "enemy" end
                if c.B >= cfg.allyB then return "ally" end
            end
            return "unknown"
        end

        local function GetRoot(plr)
            local char = plr and plr.Character
            if not char then return nil end
            return char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("Torso")
        end

        if _G.vanz.Runtime.ScanConn then
            _G.vanz.Runtime.ScanConn:Disconnect()
        end

        _G.vanz.Runtime.ScanConn = RunService.RenderStepped:Connect(function()
            if not (_G.vanz.Settings.VisualLine
                 or _G.vanz.Settings.FireButton) then
                return
            end

            local myRoot = GetRoot(LocalPlayer)
            if not myRoot then
                _G.vanz.Runtime.Target = nil
                return
            end

            local bestDist, best = math.huge, nil
            local myPos = myRoot.Position

            for _, plr in ipairs(Players:GetPlayers()) do
                if Classify(plr) == "enemy" then
                    local root = GetRoot(plr)
                    if root then
                        local d = (root.Position - myPos).Magnitude
                        if d < bestDist then
                            bestDist, best = d, plr
                        end
                    end
                end
            end

            _G.vanz.Runtime.Target = best
        end)

        print("[VANZ] TargetScan ready.")
    end, handler)
end

--========================================================--
-- 4_VELOCITY_TRACKER
--========================================================--
do
    local BLOCK = "4_VELOCITY_TRACKER"
    local function handler(err)
        warn(string.format("[VANZ ERROR][%s] %s\n%s",
            BLOCK, tostring(err), debug.traceback("", 2)))
    end

    xpcall(function()
        local Players    = game:GetService("Players")
        local RunService = game:GetService("RunService")

        _G.vanz.Runtime.VelTracker = _G.vanz.Runtime.VelTracker or {}

        local SAMPLE_WINDOW = 0.05
        local MAX_SAMPLES   = 30
        local SMOOTH_ALPHA  = 0.68

        local function GetRoot(plr)
            local char = plr and plr.Character
            if not char then return nil end
            return char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
        end

        local function Sample(plr, maxDist, myPos)
            local root = GetRoot(plr)
            if not root then return end

            if maxDist and myPos then
                local d = (root.Position - myPos).Magnitude
                if d > maxDist then
                    _G.vanz.Runtime.VelTracker[plr] = nil
                    return
                end
            end

            local now = tick()
            local pos = root.Position

            local tracker = _G.vanz.Runtime.VelTracker[plr]
            if not tracker then
                tracker = {
                    samples        = {},
                    smoothVel      = Vector3.zero,
                    lastSpeed      = 0,
                    lastPos        = pos,
                    unchangedCount = 0,
                }
                _G.vanz.Runtime.VelTracker[plr] = tracker
            end

            if (pos - tracker.lastPos).Magnitude < 0.05 then
                tracker.unchangedCount = tracker.unchangedCount + 1
                if tracker.unchangedCount > 3 then
                    tracker.smoothVel = Vector3.zero
                    tracker.lastSpeed = 0
                    return
                end
            else
                tracker.unchangedCount = 0
            end
            tracker.lastPos = pos

            table.insert(tracker.samples, { t = now, pos = pos })
            while #tracker.samples > MAX_SAMPLES do
                table.remove(tracker.samples, 1)
            end

            while #tracker.samples > 2
            and (now - tracker.samples[1].t) > SAMPLE_WINDOW do
                table.remove(tracker.samples, 1)
            end

            if #tracker.samples >= 2 then
                local oldest = tracker.samples[1]
                local newest = tracker.samples[#tracker.samples]
                local dt = newest.t - oldest.t

                if dt > 0.003 then
                    local instVel = (newest.pos - oldest.pos) / dt
                    tracker.smoothVel = tracker.smoothVel:Lerp(instVel, SMOOTH_ALPHA)
                    tracker.lastSpeed = tracker.smoothVel.Magnitude
                end
            end
        end

        if _G.vanz.Runtime.VelConn then
            _G.vanz.Runtime.VelConn:Disconnect()
        end

        _G.vanz.Runtime.VelConn = RunService.RenderStepped:Connect(function()
            if not (_G.vanz.Settings.VisualLine
                 or _G.vanz.Settings.FireButton
                 or _G.vanz.Settings.LeadPredict) then
                return
            end

            local lp = Players.LocalPlayer
            local myChar = lp.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myPos = myRoot and myRoot.Position
            local maxDist = _G.vanz.AimCfg.maxScanDistance or 999

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp then
                    Sample(plr, maxDist, myPos)
                end
            end
        end)

        _G.vanz.SampleNow = function(plr)
            if not plr then return end
            local lp = Players.LocalPlayer
            local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            local myPos = myRoot and myRoot.Position
            Sample(plr, nil, myPos)
        end

        _G.vanz.GetPlayerVelocity = function(plr)
            if not plr then return Vector3.zero end
            local tr = _G.vanz.Runtime.VelTracker[plr]
            if not tr then return Vector3.zero end
            return tr.smoothVel
        end

        _G.vanz.GetPlayerSpeed = function(plr)
            return _G.vanz.GetPlayerVelocity(plr).Magnitude
        end

        print(string.format(
            "[VANZ] VelocityTracker MAX: window=%.3fs samples=%d alpha=%.2f",
            SAMPLE_WINDOW, MAX_SAMPLES, SMOOTH_ALPHA))
    end, handler)
end

