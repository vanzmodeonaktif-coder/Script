	S.enabled = not S.enabled
	setBtn(S.enabled)
	if S.enabled then
		-- Auto detect generator point
		local list = BuildGenList()
		S.gen = list[1] and list[1].point or nil
		if not S.gen then
			-- fallback: scan workspace bebas
			for _, d in ipairs(workspace:GetDescendants()) do
				if d:IsA("BasePart") and d.Name:match("^GeneratorPoint%d+$") then
					S.gen = d
					break
				end
			end
		end
		info.Text = S.gen and ("found: "..S.gen:GetFullName()) or "no generator"
		S.fired = false
		saveCF()
		firePattern()
	else
		S.fired = false
		task.wait(0.1)
		restoreCF()
	end
end)

