local function refreshGameState()
    Debug.nudge = "Waiting Map..."
    task.spawn(function()
        local timeout = tick() + 20 
        while tick() < timeout do
            if findParryButtonLive() then break end 
            task.wait(0.2)
        end
    end)

    task.spawn(function()
        task.wait(1.5) 
        if not findParryButtonLive() then Debug.nudge = "No Btn" return end
        
        Debug.nudge = "Refreshing..."
        local char = LP.Character
        if not char then return end
        
        local dagger = char:FindFirstChild("Parrying Dagger") 
        if not dagger and LP:FindFirstChild("Backpack") then
            dagger = LP:FindFirstChild("Backpack"):FindFirstChild("Parrying Dagger")
        end
        
        if dagger then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                if dagger.Parent == char then
                    hum:UnequipTools()
                    task.wait(0.3)
                    hum:EquipTool(dagger)
                    task.wait(0.3)
                else
                    hum:EquipTool(dagger)
                    task.wait(0.3)
                end
                
                local oldSpeed = hum.WalkSpeed
                hum.WalkSpeed = oldSpeed + 0.01
                task.wait(0.1)
                hum.WalkSpeed = oldSpeed
                
                Debug.nudge = "Refreshed OK"
            end
        else
            Debug.nudge = "No Dagger"
        end
    end)
end

