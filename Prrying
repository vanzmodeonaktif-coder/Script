local function setRadius(v)
    v = tonumber(v)
    if not v then return end
    if v < 0 then v = 0 end
    State.radius = v
    if radInput.Text ~= tostring(v) then radInput.Text = tostring(v) end
end
minusBtn.MouseButton1Click:Connect(function() setRadius(State.radius - 1) end)
plusBtn.MouseButton1Click:Connect(function() setRadius(State.radius + 1) end)
radInput.FocusLost:Connect(function()
    local v = tonumber(radInput.Text)
    if v then setRadius(v) else radInput.Text = tostring(State.radius) end
end)
dotInput.FocusLost:Connect(function()
    local v = tonumber(dotInput.Text)
    if v then
        v = math.clamp(v, -1, 1)
        State.dot = v
        dotInput.Text = tostring(v)
    else
        dotInput.Text = tostring(State.dot)
    end
end)

