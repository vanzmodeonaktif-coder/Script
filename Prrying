-- ============ BYPASS ALL STATES (SILENT PARRY) ============
local function bypassAllStates()
    if not State.silentParry or not LP.Character then return end
    local char = LP.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local check = char:FindFirstChild("CheckInterractable")
    
    if hrp then
        pcall(function() game:GetService("CollectionService"):RemoveTag(hrp, "doing action") end)
    end
    if check then
        pcall(function() check:SetAttribute("isVaulting", false) end)
        pcall(function() check:SetAttribute("isRepairing", false) end)
        pcall(function() check:SetAttribute("isHealing", false) end)
        pcall(function() check:SetAttribute("isUnhooking", false) end)
    end
    
    pcall(function() char:SetAttribute("Trapped", false) end)
    pcall(function() char:SetAttribute("IsCarried", false) end)
    pcall(function() char:SetAttribute("IsHooked", false) end)
    pcall(function() LP:SetAttribute("IsDead", false) end)
end

