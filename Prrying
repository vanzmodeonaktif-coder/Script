-- ============ AUTO-TRIGGER PARRY (UPDATED METHOD) ============
local lastTriggerAt = 0
local function triggerParry(reason)
    if tick() < ServerCD_EndTime then
        Debug.lastError = string.format("on CD (%.1fs)", ServerCD_EndTime - tick())
        return false
    end

    Debug.triggerAttempts = Debug.triggerAttempts + 1
    Debug.lastTriggerAt = tick()
    Debug.lastTriggerReason = tostring(reason or "-")

    lastTriggerAt = tick()

    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then
        Debug.lastError = "no PlayerGui"
        return false
    end

    local survivorMob = pg:FindFirstChild("Survivor-mob")
    if not survivorMob then
        Debug.lastError = "no Survivor-mob"
        return false
    end

    local controls = survivorMob:FindFirstChild("Controls")
    if not controls then
        Debug.lastError = "no Controls"
        return false
    end

    local btn = controls:FindFirstChild("Gui-mob")
    if not btn then
        Debug.lastError = "no Gui-mob"
        return false
    end

    bypassAllStates()

    if not getconnections or not getupvalues then
        Debug.lastError = "no exploit fn"
        return false
    end

    local okConns, conns = pcall(getconnections, btn.MouseButton1Down)
    if not okConns or not conns or not conns[1] then
        Debug.lastError = "no conns"
        return false
    end

    local conn = conns[1]
    local okUps, ups = pcall(getupvalues, conn.Function)
    if not okUps or not ups then
        Debug.lastError = "no upvalues"
        return false
    end

    local inst = nil
    for _, uv in ipairs(ups) do
        if type(uv) == "table" and type(uv.Parry) == "function" then
            inst = uv
            break
        end
    end

    if not inst then
        Debug.lastError = "no inst Parry"
        return false
    end

    -- Cek CanUse
    local okCan, can = pcall(inst.CanUse, inst)
    if not okCan or not can then
        Debug.lastError = "CanUse=false"
        return false
    end

    -- Eksekusi Parry Mentah
    local ok, err = pcall(function()
        inst:Parry()
    end)

    if ok then
        Debug.lastFireMethod = "MethodCall:Parry"
        Debug.lastError = "-"
        return true
    else
        Debug.lastError = "call err: " .. tostring(err)
        return false
    end
end

-- ============ AUTO-TRIGGER CROUCH (METHOD CALL) ============
local function triggerCrouch()
    local btn
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        local folder = pg:FindFirstChild("Survivor-mob")
        if folder then
            local ctrl = folder:FindFirstChild("Controls")
            if ctrl then
                btn = ctrl:FindFirstChild("crouch")
            end
        end
    end

    if not btn then return end
    if not getconnections or not getupvalues then return end

    local instance = nil

    local okConns, conns = pcall(getconnections, btn.MouseButton1Click)
    if not okConns or not conns then return end

    for _, c in ipairs(conns) do
        if c.Enabled ~= false then
            local ok, ups = pcall(getupvalues, c.Function)
            if ok and ups then
                for _, uv in ipairs(ups) do
                    if type(uv) == "table" then
                        if type(uv._setCrouching) == "function" then
                            instance = uv
                            break
                        end
                    end
                end
            end
        end
        if instance then break end
    end

    if not instance then return end

    pcall(function()
        if instance.isCtrlHeld or (instance.humanoid.Health <= 59 or (not instance:_isGrounded() or (instance:_getActiveAction() or instance.character:GetAttribute("Rooted")))) then
            instance.isCtrlHeld = false
            instance.character:SetAttribute("Crouching", false)
            instance.changeatt:FireServer("Crouchingserver", false)
            if instance._checkConditions then instance:_checkConditions() end
            instance.humanoid:ChangeState(Enum.HumanoidStateType.Landed)
            if instance._refreshMobileButtons then instance:_refreshMobileButtons() end
        else
            instance.isCtrlHeld = true
            instance.isShiftHeld = false
            if instance._syncSprint then instance:_syncSprint() end
            instance.character:SetAttribute("Crouching", true)
            instance.changeatt:FireServer("Crouchingserver", true)
            instance.runevent:FireServer(instance.character, false)
            if instance._checkConditions then instance:_checkConditions() end
            instance.humanoid:ChangeState(Enum.HumanoidStateType.Landed)
            if instance._refreshMobileButtons then instance:_refreshMobileButtons() end
        end
    end)
end

