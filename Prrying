-- ============ LOS FILTERS ============
local NON_WALL_NAMES = {
    hitbox=true, hitboxes=true, weapon=true, weaponhitbox=true, stunshove=true,
    rushvfx=true, vfxdebris=true, vfx=true, effect=true, effects=true, fx=true,
}
local function nameIsNonWall(name)
    if not name then return false end
    return NON_WALL_NAMES[string.lower(name)] == true
end
local function hasHumanoidAncestor(inst)
    local model = inst:FindFirstAncestorOfClass("Model")
    while model do
        if model:FindFirstChildOfClass("Humanoid") then return true end
        model = model:FindFirstAncestorOfClass("Model")
        if model and model.Parent == workspace then break end
    end
    return false
end
local function isNonWallHit(inst, killerChar)
    if not inst then return true end
    if killerChar and inst:IsDescendantOf(killerChar) then return true end
    for _, p in ipairs(Players:GetPlayers()) do
        local c = p.Character
        if c and inst:IsDescendantOf(c) then return true end
    end
    if hasHumanoidAncestor(inst) then return true end
    if nameIsNonWall(inst.Name) then return true end
    local anc = inst.Parent
    while anc and anc ~= workspace do
        if nameIsNonWall(anc.Name) then return true end
        anc = anc.Parent
    end
    return false
end
local function buildRayFilter(myChar, killerChar)
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local c = p.Character
        if c then table.insert(list, c) end
    end
    if myChar then table.insert(list, myChar) end
    if killerChar then table.insert(list, killerChar) end
    for _, n in ipairs({"Hitboxes","Hitbox","VFX","Vfx","Effects","FX"}) do
        local f = workspace:FindFirstChild(n)
        if f then table.insert(list, f) end
    end
    return list
end

-- ============ LUNGE TRACKER (0.55 SEC WINDOW) ============
local function trackLungeWindow(killerChar, lungeId, myToken)
    local startTime = tick()
    local timeout = 0.55
    local hasParried = false
    
    while tick() - startTime < timeout do
        if activeTrackerToken ~= myToken or not killerChar or not killerChar.Parent then return end
        
        local myChar = LP.Character
        if not myChar then return end
        
        local kHRP = killerChar:FindFirstChild("HumanoidRootPart")
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if not kHRP or not myHRP or not myHum then return end
        
        local delta = myHRP.Position - kHRP.Position
        local dist = delta.Magnitude
        Debug.distance = dist
        
        if dist <= State.radius then
            local toMe = delta.Unit
            local fdot = kHRP.CFrame.LookVector:Dot(toMe)
            Debug.facing = fdot
            
            if fdot >= State.dot then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = buildRayFilter(myChar, killerChar)
                local wallHit = workspace:Raycast(myHRP.Position, kHRP.Position - myHRP.Position, rp)
                
                local isWall = false
                if wallHit and wallHit.Instance then
                    if not isNonWallHit(wallHit.Instance, killerChar) then
                        isWall = true
                        Debug.wallHit = wallHit.Instance:GetFullName()
                    end
                end
                
                if not isWall then
                    Debug.lastError = "tracker: caught!"
                    triggerParry("tracker:"..lungeId)
                    hasParried = true
                    return
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
    
    if not hasParried then
        Debug.lastError = "tracker: expired"
    end
end

local function handleAnim(track)
    if not State.autoParry then
        Debug.lastError = "autoParry off"
        return
    end
    local anim = track.Animation
    if not anim then return end
    local id = string.match(anim.AnimationId or "", "%d+")
    if not id then return end
    Debug.lastAnimId = id
    Debug.lastAnimAgo = tick()
    
    local killerChar = currentKiller
    if not killerChar or not killerChar.Parent then return end

    local myChar = LP.Character
    if not myChar then return end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local kHRP = killerChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not kHRP then return end

    local dist = (myHRP.Position - kHRP.Position).Magnitude
    Debug.distance = dist

    if id == ABYSS_SLASH_ID then
        if dist <= 30 and not isCrouchSequenceActive then
            isCrouchSequenceActive = true
            triggerCrouch()
            task.delay(3.05, function()
                triggerCrouch()
                isCrouchSequenceActive = false
            end)
        end
        return
    end

    if not LUNGE_IDS[id] then return end
    
    if dist <= State.radius then
        local delta = myHRP.Position - kHRP.Position
        local toMe = delta.Unit
        local fdot = kHRP.CFrame.LookVector:Dot(toMe)
        if fdot >= State.dot then
            triggerParry("direct_frame:"..id)
            return
        end
    end

    activeTrackerToken = activeTrackerToken + 1
    local myToken = activeTrackerToken
    
    task.spawn(function()
        trackLungeWindow(killerChar, id, myToken)
    end)
end

local function tryHook(killerChar)
    if not killerChar or not killerChar.Parent then return end
    local hum = killerChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = killerChar:FindFirstChildOfClass("Animator") end
    if not animator then animator = killerChar:FindFirstChild("Animator", true) end
    if not animator then return end
    if hookedAnimator == animator and killerHookConn then return end

    if killerHookConn then pcall(function() killerHookConn:Disconnect() end) end
    hookedAnimator = animator
    Debug.animatorPath = animator:GetFullName()
    killerHookConn = animator.AnimationPlayed:Connect(function(track)
        pcall(handleAnim, track)
    end)
    Debug.hooked = true

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        task.spawn(function() pcall(handleAnim, track) end)
    end
end

task.spawn(function()
